---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---
<Layout title="Lista de Precios">
  <header class="py-6 mb-4 border-b border-dark-border/50 flex items-center justify-between">
    <div>
      <h1 class="font-['Outfit'] text-2xl font-bold text-orange-400">🏷️ Lista de Precios</h1>
      <p class="text-xs text-text-muted mt-1">Precio efectivo = (costo ingredientes + costo operativo) × markup — Empanadas: por unidad (costo op. ÷ 12)</p>
    </div>
    <button id="btn-print" class="bg-dark-surface border border-dark-border text-text-muted text-xs px-3 py-2 rounded-xl hover:text-text-main transition-all">🖨️ Imprimir</button>
  </header>

  <!-- Barra de contexto -->
  <div class="glass-panel rounded-2xl p-4 mb-4 grid grid-cols-2 lg:grid-cols-4 gap-3">
    <div>
      <p class="text-[0.6rem] text-text-muted uppercase tracking-wider">Total Op. Mes</p>
      <p class="font-bold text-purple-400" id="ctx-total-op">—</p>
    </div>
    <div>
      <p class="text-[0.6rem] text-text-muted uppercase tracking-wider">Pizzas / Mes</p>
      <p class="font-bold text-text-muted" id="ctx-pizzas">—</p>
    </div>
    <div>
      <p class="text-[0.6rem] text-text-muted uppercase tracking-wider">Costo Op. / Pizza</p>
      <p class="font-bold text-purple-400" id="ctx-costo-op">—</p>
    </div>
    <div>
      <p class="text-[0.6rem] text-text-muted uppercase tracking-wider">Última actualización</p>
      <p class="font-bold text-text-muted text-xs" id="ctx-updated">—</p>
    </div>
  </div>

  <!-- Tabla de precios -->
  <div class="glass-panel rounded-2xl overflow-hidden mb-4">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-text-muted text-[0.65rem] uppercase tracking-wider border-b border-dark-border/50">
            <th class="text-left p-3">Pizza</th>
            <th class="text-right p-3">Ingredientes</th>
            <th class="text-right p-3">+ Op/pizza</th>
            <th class="text-right p-3">= Costo Real</th>
            <th class="text-right p-3">Margen %</th>
            <th class="text-right p-3 text-orange-400">Precio Efectivo</th>
            <th class="p-3"></th>
          </tr>
        </thead>
        <tbody id="tbody-precios">
          <tr><td colspan="7" class="p-6 text-center text-text-muted text-sm">Cargando precios...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <button id="btn-add-precio" class="glass-panel rounded-2xl px-4 py-3 text-sm text-text-muted hover:text-text-main hover:border-orange-500/50 transition-all w-full">+ Agregar producto a la lista</button>

  <!-- Recetas sin precio -->
  <div id="recetas-huerfanas" class="glass-panel rounded-2xl p-5 mt-6 hidden">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-xs uppercase tracking-wider text-red-400 font-bold">Recetas sin precio de venta</h2>
      <button id="btn-sync-todas" class="text-xs bg-orange-500/20 text-orange-400 px-3 py-1.5 rounded-lg hover:bg-orange-500/40 transition-all font-medium">Sincronizar todas</button>
    </div>
    <p class="text-[0.65rem] text-text-muted mb-3">Estas recetas no están en la lista de precios. Agregalas individualmente o sincronizá todas juntas.</p>
    <div id="lista-huerfanas" class="space-y-1 mb-3"></div>
  </div>
</Layout>

<script>
  import { insforge } from '../lib/insforge';
  import { calcCostoOperativoPorPizza, calcCostoReceta, calcCostoRealTotal, calcPrecioEfectivo, markupToMargen, margenToMarkup, calcUnidadesReceta } from '../utils/pricing';
  import { fmt, showDbError, escapeHtml, dbWrite } from '../utils/fmt';

  const db = insforge.database;
  let costoOpPorPizza = 0;
  let _syncInitialized = false;
  let _huerfanasGuard: { id: string; nombre: string }[] = [];

  const CATEGORIAS = ['Pizzas', 'Calzones', 'Empanadas', 'Hamburguesas', 'Lomos', 'Bebidas', 'Otros'] as const;

  async function init() {
    const [{ data: fijos }, { data: variables }, { data: gastosRows }, { data: config }] = await Promise.all([
      db.from('costos_fijos').select('monto').eq('activo', true),
      db.from('costos_variables').select('monto_referencia'),
      db.from('gastos').select('monto'),
      db.from('config_negocio').select('pizzas_objetivo_mes').limit(1),
    ]);

    const totalFijos = (fijos ?? []).reduce((acc: number, c: any) => acc + (Number(c?.monto) || 0), 0);
    const totalVariables = (variables ?? []).reduce((acc: number, c: any) => acc + (Number(c?.monto_referencia) || 0), 0);
    const totalGastos = (gastosRows ?? []).reduce((acc: number, g: any) => acc + (Number(g?.monto) || 0), 0);
    const totalOp = totalFijos + totalVariables + totalGastos;

    const pizzasMes = Number(config?.[0]?.pizzas_objetivo_mes) || 800;
    costoOpPorPizza = calcCostoOperativoPorPizza(totalOp, pizzasMes);

    document.getElementById('ctx-total-op')!.textContent = fmt(totalOp);
    document.getElementById('ctx-pizzas')!.textContent = String(pizzasMes);
    document.getElementById('ctx-costo-op')!.textContent = fmt(costoOpPorPizza);
    document.getElementById('ctx-updated')!.textContent = new Date().toLocaleTimeString('es-AR');

    await renderTabla();
  }

  async function renderTabla() {
    const [
      { data: precios },
      { data: recetas },
      { data: recetaIngs },
      { data: ingredientes },
    ] = await Promise.all([
      db.from('precios_venta').select('*').order('nombre', { ascending: true }),
      db.from('recetas').select('id, nombre, precio_prepizza, precio_salsa, rend_tipo, rend_valor'),
      db.from('receta_ingredientes').select('*'),
      db.from('ingredientes').select('id, precio_kg, multiplo_rendimiento'),
    ]);

    const recetasMap = new Map((recetas ?? []).map((r: any) => [r.id, r]));
    const ingMap = new Map((ingredientes ?? []).map((i: any) => [i.id, i]));
    const riByReceta = new Map<string, any[]>();
    for (const ri of (recetaIngs ?? [])) {
      if (!riByReceta.has(ri.receta_id)) riByReceta.set(ri.receta_id, []);
      riByReceta.get(ri.receta_id)!.push(ri);
    }

    const porCategoria = new Map<string, any[]>();
    for (const cat of CATEGORIAS) porCategoria.set(cat, []);

    for (const item of (precios ?? [])) {
      const cat = CATEGORIAS.includes(item.subcategoria) ? item.subcategoria : 'Otros';
      const receta = item.receta_id ? recetasMap.get(item.receta_id) : null;
      let costoIng = 0;
      if (receta) {
        const ings = (riByReceta.get(receta.id) ?? []).map((ri: any) => {
          const ing = ingMap.get(ri.ingrediente_id);
          return {
            precio_kg: Number(ing?.precio_kg ?? 0),
            cantidad_kg: Number(ri.cantidad_kg ?? 0),
            multiplo_rendimiento: Number(ing?.multiplo_rendimiento ?? 1),
          };
        });
        const prepizza = Number(receta.precio_prepizza ?? 0);
        const salsa = Number(receta.precio_salsa ?? 0);
        const costoReceta = calcCostoReceta(ings, prepizza, salsa);

        if (cat === 'Empanadas' || receta.rend_tipo === 'peso') {
          const gramosPorUnidad = Number(receta.rend_valor) || 65;
          const unidades = calcUnidadesReceta(ings, gramosPorUnidad);
          costoIng = unidades > 0 ? costoReceta / unidades : costoReceta;
        } else if (receta.rend_tipo === 'directo' && Number(receta.rend_valor) > 1) {
          costoIng = costoReceta / Number(receta.rend_valor);
        } else {
          costoIng = costoReceta;
        }
      }
      const costoOpUnit = cat === 'Empanadas' ? Math.round(costoOpPorPizza / 12) : cat === 'Bebidas' ? 0 : costoOpPorPizza;
      const costoReal = calcCostoRealTotal(costoIng, costoOpUnit);
      const markup = Number(item.markup) || 1;
      const precioEfectivo = calcPrecioEfectivo(costoReal, markup);
      porCategoria.get(cat)!.push({ item, costoIng, costoOpUnit, costoReal, precioEfectivo });
    }

    let html = '';
    for (const cat of CATEGORIAS) {
      const filas = porCategoria.get(cat)!;
      const markups = [...new Set(filas.map(r => Number(r.item.markup)))];
      const margenDisplay = filas.length > 0 && markups.length === 1 ? String(markupToMargen(markups[0])) : '';
      const margenPlaceholder = filas.length === 0 ? '—' : markups.length > 1 ? 'Mixto' : '';

      html += `
        <tr class="bg-dark-surface/60 border-t-2 border-orange-500/30">
          <td colspan="4" class="px-3 py-2">
            <span class="text-orange-400 text-[0.65rem] font-bold uppercase tracking-widest">${cat}</span>
            <span class="text-text-muted text-[0.6rem] ml-2">${filas.length} producto${filas.length !== 1 ? 's' : ''}</span>
          </td>
          <td class="px-3 py-2">
            <div class="flex items-center justify-end gap-1">
              <input type="number" step="0.1" min="1" max="99"
                value="${margenDisplay}" placeholder="${margenPlaceholder}"
                ${filas.length === 0 ? 'disabled' : ''}
                class="w-20 bg-dark-bg border border-orange-500/40 rounded-lg px-2 py-1 text-right text-orange-400 text-sm focus:ring-1 focus:ring-orange-500/50 outline-none disabled:opacity-30 grupo-margen-input"
                data-grupo="${cat}">
              <span class="text-text-muted text-xs">%</span>
            </div>
          </td>
          <td class="px-3 py-2 text-right" colspan="2">
            ${filas.length > 0 ? `
            <button class="text-xs bg-orange-500/20 hover:bg-orange-500/40 text-orange-400 px-3 py-1 rounded-lg transition-all font-medium btn-apply-grupo" data-grupo="${cat}">
              Aplicar al grupo
            </button>` : ''}
          </td>
        </tr>
      `;

      for (const { item, costoIng, costoOpUnit, costoReal, precioEfectivo } of filas) {
        const margen = markupToMargen(item.markup);
        const margenColor = margen >= 40 ? 'text-emerald-400' : margen >= 30 ? 'text-amber-400' : 'text-red-400';
        const margenBorder = margen >= 40 ? 'border-dark-border' : margen >= 30 ? 'border-amber-500/50' : 'border-red-500/60';
        const alerta = margen < 30 ? '<span title="Margen bajo — revisar precio" class="text-red-400 text-xs">⚠</span>' : '';
        html += `
          <tr class="border-b border-dark-border/20 hover:bg-dark-surface/20 item-row" data-costo-real="${costoReal}" data-id="${item.id}" data-grupo="${cat}">
            <td class="p-3 pl-5 text-text-main">${escapeHtml(item.nombre)}</td>
            <td class="p-3 text-right text-emerald-400">${fmt(costoIng)}</td>
            <td class="p-3 text-right text-purple-400">${fmt(costoOpUnit)}</td>
            <td class="p-3 text-right text-text-muted">${fmt(costoReal)}</td>
            <td class="p-3 text-right">
              <div class="flex items-center justify-end gap-1">
                ${alerta}
                <input type="number" step="0.1" min="1" max="99" value="${margen}" data-id="${item.id}"
                  class="w-20 bg-dark-bg border ${margenBorder} rounded-lg px-2 py-1 text-right ${margenColor} text-sm focus:ring-1 focus:ring-accent-amber/50 outline-none markup-input">
                <span class="text-text-muted text-xs">%</span>
              </div>
            </td>
            <td class="p-3 text-right font-bold text-white text-base precio-efectivo">${fmt(precioEfectivo)}</td>
            <td class="p-3">
              <button data-id="${item.id}" class="text-red-400 text-xs hover:text-red-300 btn-del-precio">✕</button>
            </td>
          </tr>
        `;
      }
    }

    document.getElementById('tbody-precios')!.innerHTML = html;

    // ─── Recetas sin precio de venta ───
    const idsConPrecio = new Set((precios ?? []).map((p: any) => p.receta_id).filter(Boolean));
    const huerfanas = (recetas ?? []).filter((r: any) => !idsConPrecio.has(r.id));
    _huerfanasGuard = huerfanas.map((r: any) => ({ id: r.id, nombre: r.nombre }));

    const container = document.getElementById('recetas-huerfanas')!;
    const lista = document.getElementById('lista-huerfanas')!;
    if (huerfanas.length === 0) {
      container.classList.add('hidden');
    } else {
      container.classList.remove('hidden');
      lista.innerHTML = huerfanas.map((r: any) => {
        const ings = (riByReceta.get(r.id) ?? []).map((ri: any) => {
          const ing = ingMap.get(ri.ingrediente_id);
          return { precio_kg: Number(ing?.precio_kg ?? 0), cantidad_kg: Number(ri.cantidad_kg ?? 0), multiplo_rendimiento: Number(ing?.multiplo_rendimiento ?? 1) };
        });
        const costo = calcCostoReceta(ings, Number(r.precio_prepizza ?? 0), Number(r.precio_salsa ?? 0));
        return `<div class="flex items-center justify-between py-2 border-b border-dark-border/20">
          <div>
            <span class="text-text-main text-sm font-medium">${escapeHtml(r.nombre)}</span>
            <span class="text-emerald-400 text-xs ml-2 font-mono">${fmt(costo)}</span>
          </div>
          <button data-receta-id="${r.id}" data-receta-nombre="${escapeHtml(r.nombre)}" class="text-xs bg-accent-amber/20 text-accent-amber px-3 py-1.5 rounded-lg hover:bg-accent-amber/30 transition-all btn-agregar-huerfana">+ Agregar</button>
        </div>`;
      }).join('');

      lista.querySelectorAll('.btn-agregar-huerfana').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const el = e.target as HTMLElement;
          const rid = el.dataset.recetaId!;
          const rnombre = el.dataset.recetaNombre!;
          const catsStr = CATEGORIAS.map((c, i) => `${i + 1}. ${c}`).join('\n');
          const catInput = prompt(`Categoría para "${rnombre}":\n${catsStr}`);
          if (!catInput) return;
          const catIdx = parseInt(catInput) - 1;
          const sub = (catIdx >= 0 && catIdx < CATEGORIAS.length) ? CATEGORIAS[catIdx] : 'Otros';
          await dbWrite(() => db.from('precios_venta').insert([{ nombre: rnombre, subcategoria: sub, receta_id: rid, markup: 1.6 }]).select());
          renderTabla();
        });
      });
    }

    if (!_syncInitialized) {
      _syncInitialized = true;
      document.getElementById('btn-sync-todas')!.addEventListener('click', async () => {
        if (_huerfanasGuard.length === 0) return;
        const catsStr = CATEGORIAS.map((c, i) => `${i + 1}. ${c}`).join('\n');
        const catInput = prompt(`Categoría para TODAS las recetas sin precio:\n${catsStr}`);
        if (!catInput) return;
        const catIdx = parseInt(catInput) - 1;
        const sub = (catIdx >= 0 && catIdx < CATEGORIAS.length) ? CATEGORIAS[catIdx] : 'Otros';
        const inserts = _huerfanasGuard.map((r) => ({ nombre: r.nombre, subcategoria: sub, receta_id: r.id, markup: 1.6 }));
        await dbWrite(() => db.from('precios_venta').insert(inserts).select());
        renderTabla();
      });
    }

    // Margen individual
    document.querySelectorAll('.markup-input').forEach(inp => {
      inp.addEventListener('change', async (e) => {
        const el = e.target as HTMLInputElement;
        const margen = parseFloat(el.value);
        if (isNaN(margen) || margen <= 0 || margen >= 100) return;
        const newMarkup = margenToMarkup(margen);
        await dbWrite(() => db.from('precios_venta').update({ markup: newMarkup }).eq('id', el.dataset.id!).select());
        const row = el.closest('tr') as HTMLElement;
        const costoReal = parseFloat(row.dataset.costoReal || '0');
        row.querySelector('.precio-efectivo')!.textContent = fmt(calcPrecioEfectivo(costoReal, newMarkup));
        applyMargenStyle(el, margen);
        syncGrupoInput(row.dataset.grupo!);
      });
    });

    // Aplicar margen al grupo completo
    document.querySelectorAll('.btn-apply-grupo').forEach(btn => {
      btn.addEventListener('click', async () => {
        const cat = (btn as HTMLElement).dataset.grupo!;
        const grupoInput = document.querySelector<HTMLInputElement>(`.grupo-margen-input[data-grupo="${cat}"]`)!;
        const margen = parseFloat(grupoInput.value);
        if (isNaN(margen) || margen <= 0 || margen >= 100) return;
        const newMarkup = margenToMarkup(margen);
        const itemRows = document.querySelectorAll<HTMLElement>(`.item-row[data-grupo="${cat}"]`);
        const ids = Array.from(itemRows).map(r => r.dataset.id!);
        await dbWrite(() => db.from('precios_venta').update({ markup: newMarkup }).in('id', ids).select());
        itemRows.forEach(row => {
          const costoReal = parseFloat(row.dataset.costoReal || '0');
          row.querySelector('.precio-efectivo')!.textContent = fmt(calcPrecioEfectivo(costoReal, newMarkup));
          const inp = row.querySelector('.markup-input') as HTMLInputElement;
          inp.value = String(margen);
          applyMargenStyle(inp, margen);
        });
      });
    });

    // Borrar producto
    document.querySelectorAll('.btn-del-precio').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.target as HTMLElement).dataset.id!;
        await dbWrite(() => db.from('precios_venta').delete().eq('id', id));
        renderTabla();
      });
    });
  }

  function applyMargenStyle(inp: HTMLInputElement, margen: number) {
    inp.className = inp.className
      .replace(/text-(emerald|amber|red)-400/g, '')
      .replace(/border-(dark-border|amber-500\/50|red-500\/60)/g, '');
    const color = margen >= 40 ? 'text-emerald-400' : margen >= 30 ? 'text-amber-400' : 'text-red-400';
    const border = margen >= 40 ? 'border-dark-border' : margen >= 30 ? 'border-amber-500/50' : 'border-red-500/60';
    inp.classList.add(color, border);
    const alerta = inp.previousElementSibling;
    if (alerta?.tagName === 'SPAN') alerta.remove();
    if (margen < 30) {
      const warn = document.createElement('span');
      warn.title = 'Margen bajo — revisar precio';
      warn.className = 'text-red-400 text-xs';
      warn.textContent = '⚠';
      inp.parentElement!.insertBefore(warn, inp);
    }
  }

  function syncGrupoInput(cat: string) {
    const inputs = Array.from(document.querySelectorAll<HTMLInputElement>(`.item-row[data-grupo="${cat}"] .markup-input`));
    const vals = inputs.map(i => parseFloat(i.value));
    const grupoInput = document.querySelector<HTMLInputElement>(`.grupo-margen-input[data-grupo="${cat}"]`);
    if (!grupoInput) return;
    const allEqual = vals.every(v => v === vals[0]);
    grupoInput.value = allEqual ? String(vals[0]) : '';
    grupoInput.placeholder = allEqual ? '' : 'Mixto';
  }

  document.getElementById('btn-add-precio')!.addEventListener('click', async () => {
    const nombre = prompt('Nombre del producto:');
    if (!nombre?.trim()) return;
    const catsStr = CATEGORIAS.map((c, i) => `${i + 1}. ${c}`).join('\n');
    const catInput = prompt(`Categoría:\n${catsStr}`);
    if (catInput === null) return;
    const catIdx = parseInt(catInput) - 1;
    const subcategoria = (catIdx >= 0 && catIdx < CATEGORIAS.length) ? CATEGORIAS[catIdx] : 'Otros';
    const { data: recetas } = await db.from('recetas').select('id, nombre').order('nombre', { ascending: true });
    const lista = (recetas ?? []).map((r: any, i: number) => `${i + 1}. ${r.nombre}`).join('\n');
    const idx = parseInt(prompt(`¿A qué receta corresponde? (0 para ninguna)\n${lista}`) ?? '0') - 1;
    const receta_id = idx >= 0 ? (recetas ?? [])[idx]?.id ?? null : null;
    await dbWrite(() => db.from('precios_venta').insert([{ nombre: nombre.trim(), subcategoria, receta_id, markup: 1.6 }]).select());
    renderTabla();
  });

  document.getElementById('btn-print')!.addEventListener('click', () => window.print());

  init().catch(showDbError);
</script>
