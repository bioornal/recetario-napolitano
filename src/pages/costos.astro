---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---
<Layout title="Costos Operativos">
  <header class="py-6 mb-4 border-b border-dark-border/50">
    <h1 class="font-['Outfit'] text-2xl font-bold text-purple-400">💼 Costos Operativos</h1>
    <p class="text-xs text-text-muted mt-1">Editá los costos del negocio — afectan directamente los precios de venta</p>
  </header>

  <div class="grid lg:grid-cols-2 gap-6 mb-6">
    <!-- Costos Fijos -->
    <div class="glass-panel rounded-2xl overflow-hidden">
      <div class="flex items-center justify-between p-4 border-b border-dark-border/50">
        <h2 class="text-xs uppercase tracking-wider text-purple-400 font-bold">Costos Fijos / Mes</h2>
        <button id="btn-add-fijo" class="bg-purple-600/20 text-purple-400 text-xs px-3 py-1.5 rounded-lg hover:bg-purple-600/40 transition-all">+ Agregar</button>
      </div>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-text-muted text-[0.65rem] uppercase tracking-wider border-b border-dark-border/30">
            <th class="text-left p-3">Concepto</th>
            <th class="text-right p-3">Monto ($)</th>
            <th class="p-3">Activo</th>
            <th class="p-3"></th>
          </tr>
        </thead>
        <tbody id="tbody-fijos">
          <tr><td colspan="4" class="p-4 text-center text-text-muted text-sm">Cargando...</td></tr>
        </tbody>
      </table>
      <div class="flex justify-between p-4 border-t border-dark-border/50 bg-dark-surface/50">
        <span class="text-xs text-text-muted uppercase tracking-wider">Total fijos</span>
        <span class="font-bold text-purple-400" id="total-fijos" data-raw="0">$0</span>
      </div>
    </div>

    <!-- Costos Variables -->
    <div class="glass-panel rounded-2xl overflow-hidden">
      <div class="flex items-center justify-between p-4 border-b border-dark-border/50">
        <h2 class="text-xs uppercase tracking-wider text-purple-400 font-bold">Costos Variables / Mes</h2>
        <button id="btn-add-var" class="bg-purple-600/20 text-purple-400 text-xs px-3 py-1.5 rounded-lg hover:bg-purple-600/40 transition-all">+ Agregar</button>
      </div>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-text-muted text-[0.65rem] uppercase tracking-wider border-b border-dark-border/30">
            <th class="text-left p-3">Concepto</th>
            <th class="text-right p-3">Monto Ref. ($)</th>
            <th class="p-3"></th>
          </tr>
        </thead>
        <tbody id="tbody-variables">
          <tr><td colspan="3" class="p-4 text-center text-text-muted text-sm">Cargando...</td></tr>
        </tbody>
      </table>
      <div class="flex justify-between p-4 border-t border-dark-border/50 bg-dark-surface/50">
        <span class="text-xs text-text-muted uppercase tracking-wider">Total variables</span>
        <span class="font-bold text-purple-400" id="total-variables" data-raw="0">$0</span>
      </div>
    </div>
  </div>

  <!-- Resumen + pizzas objetivo y ritmo diario -->
  <div class="glass-panel rounded-2xl p-5 mb-6">
    <h2 class="text-xs uppercase tracking-wider text-accent-amber font-bold mb-4">Resumen Mensual y Estructura Operativa</h2>
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
      <div>
        <p class="text-[0.65rem] text-text-muted uppercase tracking-wider">Total Fijos</p>
        <p class="text-xl font-bold text-purple-400" id="sum-fijos">$0</p>
      </div>
      <div>
        <p class="text-[0.65rem] text-text-muted uppercase tracking-wider">Total Variables</p>
        <p class="text-xl font-bold text-purple-400" id="sum-variables">$0</p>
      </div>
      <div>
        <p class="text-[0.65rem] text-text-muted uppercase tracking-wider">Total Gastos</p>
        <p class="text-xl font-bold text-purple-400" id="sum-gastos">$0</p>
      </div>
      <div>
        <p class="text-[0.65rem] text-text-muted uppercase tracking-wider">Total Operativo Mes</p>
        <p class="text-xl font-bold text-white" id="sum-total">$0</p>
      </div>
      <div>
        <p class="text-[0.65rem] text-text-muted uppercase tracking-wider">Costo Op. por Pizza</p>
        <p class="text-xl font-bold text-accent-gold" id="costo-por-pizza">$0</p>
      </div>
    </div>

    <!-- Panel de Planificación de Ventas y Ritmo Diario -->
    <div class="bg-dark-surface/50 border border-dark-border/40 rounded-xl p-4">
      <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
        <div>
          <h3 class="text-sm font-bold text-text-main flex items-center gap-2">
            <span>🎯 Planificación y Ritmo de Ventas Requerido</span>
          </h3>
          <p class="text-[0.65rem] text-text-muted mt-0.5">
            Equivalencia de costos: <span class="text-accent-gold font-semibold">1 Pizza = 1 Docena de Empanadas (12 un.) = 1 unidad operativa</span>
          </p>
        </div>
        <div class="flex items-center gap-3 flex-wrap">
          <div class="flex items-center gap-2">
            <label class="text-xs text-text-muted">Objetivo / mes:</label>
            <input type="number" id="inp-pizzas-mes" value="800" min="1" step="10"
              class="w-20 bg-dark-bg border border-dark-border rounded-lg px-2.5 py-1 text-right text-text-main text-xs font-mono focus:ring-1 focus:ring-accent-amber/50 outline-none">
            <span class="text-xs text-text-muted">un.</span>
          </div>

          <div class="flex items-center gap-2">
            <label class="text-xs text-text-muted">Días trabajados:</label>
            <input type="number" id="inp-dias-mes" value="26" min="1" max="31" step="1"
              class="w-16 bg-dark-bg border border-dark-border rounded-lg px-2 py-1 text-right text-text-main text-xs font-mono focus:ring-1 focus:ring-accent-amber/50 outline-none">
            <span class="text-xs text-text-muted">días/mes</span>
          </div>

          <button id="btn-guardar-pizzas" class="bg-accent-amber text-dark-bg text-xs font-bold px-3 py-1.5 rounded-lg hover:bg-accent-gold transition-all">Guardar</button>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <!-- Meta Diaria -->
        <div class="bg-dark-bg/60 border border-emerald-500/30 rounded-xl p-3.5 flex flex-col justify-between">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs uppercase tracking-wider text-emerald-400 font-bold">Meta por Día Trabajado</span>
            <span class="text-lg">📅</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-2xl font-bold font-mono text-emerald-400" id="ritmo-diario-unidades">31</span>
            <span class="text-xs text-text-muted">unidades / día</span>
          </div>
          <p class="text-[0.65rem] text-text-muted mt-1.5 pt-1 border-t border-emerald-500/10" id="ritmo-diario-detalle">
            31 pizzas ó 31 docenas (372 empanadas)
          </p>
        </div>

        <!-- Meta Semanal -->
        <div class="bg-dark-bg/60 border border-purple-500/30 rounded-xl p-3.5 flex flex-col justify-between">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs uppercase tracking-wider text-purple-400 font-bold">Meta por Semana</span>
            <span class="text-lg">📆</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-2xl font-bold font-mono text-purple-300" id="ritmo-semanal-unidades">185</span>
            <span class="text-xs text-text-muted">unidades / semana</span>
          </div>
          <p class="text-[0.65rem] text-text-muted mt-1.5 pt-1 border-t border-purple-500/10" id="ritmo-semanal-detalle">
            185 pizzas ó 185 docenas de empanadas
          </p>
        </div>

        <!-- Días de Descanso -->
        <div class="bg-dark-bg/60 border border-dark-border/60 rounded-xl p-3.5 flex flex-col justify-between">
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs uppercase tracking-wider text-text-muted font-bold">Días no trabajados (Descanso)</span>
            <span class="text-lg">🏖️</span>
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-2xl font-bold font-mono text-amber-400" id="dias-descanso-count">4</span>
            <span class="text-xs text-text-muted">días libres / mes</span>
          </div>
          <p class="text-[0.65rem] text-text-muted mt-1.5 pt-1 border-t border-dark-border/30" id="dias-descanso-detalle">
            Calculado sobre 30 días del mes (1 día libre/sem.)
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Calculadora de Prepizza y Salsa -->
  <div class="glass-panel rounded-2xl p-5 mb-6 mt-6">
    <h2 class="text-xs uppercase tracking-wider text-accent-amber font-bold mb-1">Costo Base: Prepizza y Salsa</h2>
    <p class="text-[0.65rem] text-text-muted mb-4">Calculá el costo del bollo y la salsa con ingredientes reales, como una receta. Luego propagalo a las categorías que elijas.</p>

    <div class="grid lg:grid-cols-2 gap-4">
      <!-- Prepizza -->
      <div class="bg-dark-surface/40 rounded-xl p-4 border border-dark-border/30">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-bold text-text-main uppercase tracking-wider">Prepizza (Bollo)</h3>
          <span class="text-lg font-bold text-emerald-400" id="costo-prepizza-calc">$0</span>
        </div>
        <div id="ings-prepizza" class="space-y-1 mb-3 text-xs"></div>
        <button id="btn-add-ing-prepizza" class="text-xs bg-accent-amber/20 text-accent-amber px-3 py-1.5 rounded-lg hover:bg-accent-amber/30 transition-all">+ Agregar ingrediente</button>
      </div>

      <!-- Salsa -->
      <div class="bg-dark-surface/40 rounded-xl p-4 border border-dark-border/30">
        <div class="flex items-center justify-between mb-3">
          <h3 class="text-sm font-bold text-text-main uppercase tracking-wider">Salsa</h3>
          <span class="text-lg font-bold text-emerald-400" id="costo-salsa-calc">$0</span>
        </div>
        <div id="ings-salsa" class="space-y-1 mb-3 text-xs"></div>
        <button id="btn-add-ing-salsa" class="text-xs bg-accent-amber/20 text-accent-amber px-3 py-1.5 rounded-lg hover:bg-accent-amber/30 transition-all">+ Agregar ingrediente</button>
      </div>
    </div>

    <button id="btn-guardar-costos-base" class="mt-4 w-full bg-accent-amber text-dark-bg font-bold py-3 rounded-xl hover:bg-accent-gold transition-all">Guardar costos base</button>
  </div>

  <!-- Propagar a Recetas -->
  <div class="glass-panel rounded-2xl p-5 mb-6">
    <h2 class="text-xs uppercase tracking-wider text-orange-400 font-bold mb-1">Propagar costos base a recetas</h2>
    <p class="text-[0.65rem] text-text-muted mb-3">Actualiza prepizza y salsa en TODAS las recetas de las categorías que marques.</p>
    <div class="grid grid-cols-3 gap-2 mb-4 text-xs">
      <div><span class="text-text-muted">Prepizza:</span> <span class="font-bold text-emerald-400" id="ctx-prepizza">—</span></div>
      <div><span class="text-text-muted">Salsa:</span> <span class="font-bold text-emerald-400" id="ctx-salsa">—</span></div>
    </div>
    <div id="check-categorias" class="flex flex-wrap gap-3 mb-4"></div>
    <button id="btn-propagar" class="w-full bg-orange-600/20 border border-orange-500/50 text-orange-400 font-bold py-3 rounded-xl hover:bg-orange-600/40 transition-all disabled:opacity-30 disabled:cursor-not-allowed" disabled>Propagar a recetas seleccionadas</button>
    <p id="propagar-msg" class="text-xs text-emerald-400 mt-2 hidden"></p>
  </div>
</Layout>

<script>
  import { insforge } from '../lib/insforge';
  import { calcCostoOperativoPorPizza } from '../utils/pricing';
  import { fmt, TIPOS, showDbError, escapeHtml, dbWrite } from '../utils/fmt';

  const db = insforge.database;
  let pizzasMes = 800;
  let configId: string | null = null;

  // ─── Prepizza & Salsa calculator state ───
  let ingsPrepizza: any[] = [];
  let ingsSalsa: any[] = [];
  let ingredientesGlobalesCostos: any[] = [];
  let precioPrepizzaDefault = 485;
  let precioSalsaDefault = 236;
  let recetasPorCategoria: Map<string, string[]> = new Map();

  let gastosTotal = 0;
  let diasLaborablesMes = parseInt(typeof localStorage !== 'undefined' ? (localStorage.getItem('impasto_dias_laborables') || '26') : '26');
  if (isNaN(diasLaborablesMes) || diasLaborablesMes <= 0 || diasLaborablesMes > 31) diasLaborablesMes = 26;

  function recalcular() {
    const tf = parseFloat((document.getElementById('total-fijos') as HTMLElement).dataset.raw ?? '0');
    const tv = parseFloat((document.getElementById('total-variables') as HTMLElement).dataset.raw ?? '0');
    const total = tf + tv + gastosTotal;
    document.getElementById('sum-fijos')!.textContent = fmt(tf);
    document.getElementById('sum-variables')!.textContent = fmt(tv);
    document.getElementById('sum-gastos')!.textContent = fmt(gastosTotal);
    document.getElementById('sum-total')!.textContent = fmt(total);
    document.getElementById('costo-por-pizza')!.textContent = fmt(calcCostoOperativoPorPizza(total, pizzasMes));

    // ─── Ritmo de Ventas y Días Laborables ───
    const dias = diasLaborablesMes > 0 ? diasLaborablesMes : 26;
    const metaDiaria = Math.ceil(pizzasMes / dias);
    const metaSemanal = Math.ceil(pizzasMes / (dias / 6));
    const descanso = Math.max(0, 30 - dias);

    const diarioEl = document.getElementById('ritmo-diario-unidades');
    if (diarioEl) diarioEl.textContent = String(metaDiaria);
    const diarioDetEl = document.getElementById('ritmo-diario-detalle');
    if (diarioDetEl) diarioDetEl.textContent = `${metaDiaria} pizzas ó ${metaDiaria} docenas (${metaDiaria * 12} empanadas)`;

    const semEl = document.getElementById('ritmo-semanal-unidades');
    if (semEl) semEl.textContent = String(metaSemanal);
    const semDetEl = document.getElementById('ritmo-semanal-detalle');
    if (semDetEl) semDetEl.textContent = `${metaSemanal} pizzas ó ${metaSemanal} docenas de empanadas`;

    const descEl = document.getElementById('dias-descanso-count');
    if (descEl) descEl.textContent = String(descanso);
    const descDetEl = document.getElementById('dias-descanso-detalle');
    if (descDetEl) descDetEl.textContent = `Descanso: ${descanso} días libres al mes (${dias} días abiertos)`;
  }

  async function renderFijos() {
    const { data } = await db.from('costos_fijos').select('*').order('nombre', { ascending: true });
    const items = data ?? [];
    const total = items.filter((i: any) => i.activo).reduce((a: number, b: any) => a + b.monto, 0);
    const el = document.getElementById('total-fijos') as HTMLElement;
    el.textContent = fmt(total);
    el.dataset.raw = String(total);

    document.getElementById('tbody-fijos')!.innerHTML = items.map((item: any) => `
      <tr class="border-b border-dark-border/30 hover:bg-dark-surface/30">
        <td class="p-3">
          <input type="text" value="${escapeHtml(item.nombre)}" data-id="${escapeHtml(item.id)}" data-field="nombre"
            class="w-full bg-transparent text-text-main text-sm focus:outline-none focus:border-b focus:border-accent-amber cf-input">
        </td>
        <td class="p-3 text-right">
          <input type="number" value="${escapeHtml(item.monto)}" data-id="${escapeHtml(item.id)}" data-field="monto"
            class="w-28 bg-dark-bg border border-dark-border rounded-lg px-2 py-1 text-right text-accent-amber text-sm focus:ring-1 focus:ring-accent-amber/50 outline-none cf-input">
        </td>
        <td class="p-3 text-center">
          <input type="checkbox" ${item.activo ? 'checked' : ''} data-id="${escapeHtml(item.id)}"
            class="accent-purple-500 w-4 h-4 cf-check">
        </td>
        <td class="p-3">
          <button data-id="${escapeHtml(item.id)}" class="text-red-400 text-xs hover:text-red-300 btn-del-fijo">✕</button>
        </td>
      </tr>
    `).join('');

    document.querySelectorAll('.cf-input').forEach(el => {
      el.addEventListener('change', async (e) => {
        const inp = e.target as HTMLInputElement;
        const val = inp.dataset.field === 'monto' ? parseFloat(inp.value) : inp.value;
        await dbWrite(() => db.from('costos_fijos').update({ [inp.dataset.field!]: val }).eq('id', inp.dataset.id!).select());
        renderFijos();
      });
    });
    document.querySelectorAll('.cf-check').forEach(el => {
      el.addEventListener('change', async (e) => {
        const inp = e.target as HTMLInputElement;
        await dbWrite(() => db.from('costos_fijos').update({ activo: inp.checked }).eq('id', inp.dataset.id!).select());
        renderFijos();
      });
    });
    document.querySelectorAll('.btn-del-fijo').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.target as HTMLElement).dataset.id!;
        await dbWrite(() => db.from('costos_fijos').delete().eq('id', id));
        renderFijos();
      });
    });
    recalcular();
  }

  async function renderVariables() {
    const { data } = await db.from('costos_variables').select('*').order('nombre', { ascending: true });
    const items = data ?? [];
    const total = items.reduce((a: number, b: any) => a + b.monto_referencia, 0);
    const el = document.getElementById('total-variables') as HTMLElement;
    el.textContent = fmt(total);
    el.dataset.raw = String(total);

    document.getElementById('tbody-variables')!.innerHTML = items.map((item: any) => `
      <tr class="border-b border-dark-border/30 hover:bg-dark-surface/30">
        <td class="p-3">
          <input type="text" value="${escapeHtml(item.nombre)}" data-id="${escapeHtml(item.id)}" data-field="nombre"
            class="w-full bg-transparent text-text-main text-sm focus:outline-none cv-input">
        </td>
        <td class="p-3 text-right">
          <input type="number" value="${escapeHtml(item.monto_referencia)}" data-id="${escapeHtml(item.id)}" data-field="monto_referencia"
            class="w-28 bg-dark-bg border border-dark-border rounded-lg px-2 py-1 text-right text-accent-amber text-sm focus:ring-1 focus:ring-accent-amber/50 outline-none cv-input">
        </td>
        <td class="p-3">
          <button data-id="${escapeHtml(item.id)}" class="text-red-400 text-xs hover:text-red-300 btn-del-var">✕</button>
        </td>
      </tr>
    `).join('');

    document.querySelectorAll('.cv-input').forEach(el => {
      el.addEventListener('change', async (e) => {
        const inp = e.target as HTMLInputElement;
        const val = inp.dataset.field === 'monto_referencia' ? parseFloat(inp.value) : inp.value;
        await dbWrite(() => db.from('costos_variables').update({ [inp.dataset.field!]: val }).eq('id', inp.dataset.id!).select());
        renderVariables();
      });
    });
    document.querySelectorAll('.btn-del-var').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.target as HTMLElement).dataset.id!;
        await dbWrite(() => db.from('costos_variables').delete().eq('id', id));
        renderVariables();
      });
    });
    recalcular();
  }

  async function cargarGastos() {
    const { data } = await db.from('gastos').select('monto');
    gastosTotal = (data ?? []).reduce((a: number, b: any) => a + b.monto, 0);
    recalcular();
  }

  document.getElementById('btn-add-fijo')!.addEventListener('click', async () => {
    const nombre = prompt('Nombre del costo fijo:');
    if (!nombre?.trim()) return;
    const monto = parseFloat(prompt('Monto mensual ($):') ?? '0');
    await dbWrite(() => db.from('costos_fijos').insert([{ nombre: nombre.trim(), monto, activo: true }]).select());
    renderFijos();
  });

  document.getElementById('btn-add-var')!.addEventListener('click', async () => {
    const nombre = prompt('Nombre del costo variable:');
    if (!nombre?.trim()) return;
    const monto_referencia = parseFloat(prompt('Monto de referencia mensual ($):') ?? '0');
    await dbWrite(() => db.from('costos_variables').insert([{ nombre: nombre.trim(), monto_referencia }]).select());
    renderVariables();
  });

  document.getElementById('inp-dias-mes')?.addEventListener('input', (e) => {
    diasLaborablesMes = parseInt((e.target as HTMLInputElement).value) || 26;
    if (typeof localStorage !== 'undefined') localStorage.setItem('impasto_dias_laborables', String(diasLaborablesMes));
    recalcular();
  });

  document.getElementById('inp-pizzas-mes')?.addEventListener('input', (e) => {
    pizzasMes = parseInt((e.target as HTMLInputElement).value) || 800;
    recalcular();
  });

  document.getElementById('btn-guardar-pizzas')!.addEventListener('click', async () => {
    pizzasMes = parseInt((document.getElementById('inp-pizzas-mes') as HTMLInputElement).value) || 800;
    diasLaborablesMes = parseInt((document.getElementById('inp-dias-mes') as HTMLInputElement).value) || 26;
    if (typeof localStorage !== 'undefined') localStorage.setItem('impasto_dias_laborables', String(diasLaborablesMes));
    if (configId) await dbWrite(() => db.from('config_negocio').update({ pizzas_objetivo_mes: pizzasMes }).eq('id', configId).select());
    recalcular();
    alert('Objetivo de ventas y días laborables guardados ✓');
  });

  // ─── Prepizza & Salsa Calculator ───
  function calcCostoIngs(ings: any[]) {
    return Math.round(ings.reduce((acc, i) => {
      const g = i.ingredientes ?? ingredientesGlobalesCostos.find(x => x.id === i.ingrediente_id);
      return acc + (Number(g?.precio_kg ?? 0)) * (Number(i.cantidad_kg ?? 0)) * (Number(g?.multiplo_rendimiento ?? 1));
    }, 0));
  }

  function renderIngs(lista: any[], containerId: string, costoId: string) {
    const container = document.getElementById(containerId)!;
    if (lista.length === 0) {
      container.innerHTML = '<span class="text-text-muted italic">Sin ingredientes</span>';
    } else {
      container.innerHTML = lista.map((ing, idx) => {
        const g = ing.ingredientes ?? ingredientesGlobalesCostos.find(x => x.id === ing.ingrediente_id);
        const cost = Math.round(Number(g?.precio_kg ?? 0) * Number(ing.cantidad_kg ?? 0) * Number(g?.multiplo_rendimiento ?? 1));
        return `<div class="flex items-center justify-between py-1 border-b border-dark-border/20">
          <span class="text-text-main">${escapeHtml(g?.nombre ?? '?')}</span>
          <span class="text-text-muted mr-2">${Number(ing.cantidad_kg ?? 0).toFixed(3)} kg</span>
          <span class="text-emerald-400 font-mono text-xs mr-2">${fmt(cost)}</span>
          <button data-idx="${idx}" class="text-red-400 hover:text-red-300 text-xs btn-del-ing-${containerId}">✕</button>
        </div>`;
      }).join('');
    }
    document.getElementById(costoId)!.textContent = fmt(calcCostoIngs(lista));

    container.querySelectorAll(`.btn-del-ing-${containerId}`).forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = parseInt((btn as HTMLElement).dataset.idx!);
        lista.splice(idx, 1);
        renderIngs(lista, containerId, costoId);
        updatePropagarState();
      });
    });
  }

  function renderIngsPrepizza() { renderIngs(ingsPrepizza, 'ings-prepizza', 'costo-prepizza-calc'); }
  function renderIngsSalsa() { renderIngs(ingsSalsa, 'ings-salsa', 'costo-salsa-calc'); }

  function mostrarPromptIngrediente(titulo: string): any | null {
    const grupos = TIPOS.map(tipo => {
      const ings = ingredientesGlobalesCostos.filter((i: any) => (i.tipo ?? 'Varios') === tipo);
      if (ings.length === 0) return '';
      return `${tipo}:\n` + ings.map((i: any) => `  ${i.nombre}  ($${i.precio_kg}/kg, MR ${i.multiplo_rendimiento})`).join('\n');
    }).filter(Boolean).join('\n\n');
    const nombre = prompt(`${titulo}:\n\n${grupos}\n\nEscribí el nombre exacto del ingrediente:`);
    if (!nombre?.trim()) return null;
    return ingredientesGlobalesCostos.find((i: any) => i.nombre.toLowerCase() === nombre.toLowerCase().trim()) ?? null;
  }

  document.getElementById('btn-add-ing-prepizza')!.addEventListener('click', () => {
    const ing = mostrarPromptIngrediente('Agregar ingrediente a la PREPIZZA');
    if (!ing) return;
    const cant = parseFloat(prompt(`Cantidad en kg para "${ing.nombre}":`) ?? '0');
    if (!cant || cant <= 0) return;
    ingsPrepizza.push({ ingrediente_id: ing.id, cantidad_kg: cant, ingredientes: ing });
    renderIngsPrepizza();
    updatePropagarState();
  });

  document.getElementById('btn-add-ing-salsa')!.addEventListener('click', () => {
    const ing = mostrarPromptIngrediente('Agregar ingrediente a la SALSA');
    if (!ing) return;
    const cant = parseFloat(prompt(`Cantidad en kg para "${ing.nombre}":`) ?? '0');
    if (!cant || cant <= 0) return;
    ingsSalsa.push({ ingrediente_id: ing.id, cantidad_kg: cant, ingredientes: ing });
    renderIngsSalsa();
    updatePropagarState();
  });

  document.getElementById('btn-guardar-costos-base')!.addEventListener('click', async () => {
    precioPrepizzaDefault = calcCostoIngs(ingsPrepizza);
    precioSalsaDefault = calcCostoIngs(ingsSalsa);
    if (configId) {
      await dbWrite(() => db.from('config_negocio').update({
        precio_prepizza_default: precioPrepizzaDefault,
        precio_salsa_default: precioSalsaDefault,
      }).eq('id', configId).select());
    }
    document.getElementById('ctx-prepizza')!.textContent = fmt(precioPrepizzaDefault);
    document.getElementById('ctx-salsa')!.textContent = fmt(precioSalsaDefault);
    updatePropagarState();
    alert('Costos base guardados.');
  });

  // ─── Categorías & Propagación ───
  const CATEGORIAS_COSTOS = ['Pizzas', 'Calzones', 'Empanadas', 'Hamburguesas', 'Lomos', 'Otros'] as const;

  async function cargarCategoriasYRecetas() {
    const [{ data: precios }, { data: recetas }] = await Promise.all([
      db.from('precios_venta').select('receta_id, subcategoria'),
      db.from('recetas').select('id, nombre'),
    ]);
    recetasPorCategoria = new Map();
    const recetaNombres = new Map((recetas ?? []).map((r: any) => [r.id, r.nombre]));

    for (const cat of CATEGORIAS_COSTOS) {
      const ids = new Set<string>();
      for (const p of (precios ?? [])) {
        if (p.subcategoria === cat && p.receta_id) ids.add(p.receta_id);
      }
      recetasPorCategoria.set(cat, [...ids]);
    }

    const container = document.getElementById('check-categorias')!;
    container.innerHTML = CATEGORIAS_COSTOS.map(cat => {
      const ids = recetasPorCategoria.get(cat) ?? [];
      const nombres = ids.map(id => recetaNombres.get(id) ?? id.slice(0, 6)).join(', ');
      return `<label class="flex items-center gap-1.5 cursor-pointer text-xs text-text-main">
        <input type="checkbox" value="${cat}" class="accent-orange-500 w-3.5 h-3.5 chk-cat">
        <span>${cat}</span>
        <span class="text-text-muted text-[0.6rem]">(${ids.length}: ${nombres || '—'})</span>
      </label>`;
    }).join('');

    container.querySelectorAll('.chk-cat').forEach(chk => {
      chk.addEventListener('change', updatePropagarState);
    });
    updatePropagarState();
  }

  function updatePropagarState() {
    const btn = document.getElementById('btn-propagar') as HTMLButtonElement;
    const checked = document.querySelectorAll<HTMLInputElement>('.chk-cat:checked');
    btn.disabled = checked.length === 0;

    document.getElementById('ctx-prepizza')!.textContent = fmt(precioPrepizzaDefault);
    document.getElementById('ctx-salsa')!.textContent = fmt(precioSalsaDefault);
  }

  document.getElementById('btn-propagar')!.addEventListener('click', async () => {
    const checked = Array.from(document.querySelectorAll<HTMLInputElement>('.chk-cat:checked')).map(c => c.value);
    if (checked.length === 0) return;

    const todosIds = new Set<string>();
    for (const cat of checked) {
      for (const id of (recetasPorCategoria.get(cat) ?? [])) todosIds.add(id);
    }
    if (todosIds.size === 0) { alert('No hay recetas vinculadas a esas categorías.'); return; }

    const idsArr = [...todosIds];
    if (!confirm(`¿Actualizar precio_prepizza=${fmt(precioPrepizzaDefault)} y precio_salsa=${fmt(precioSalsaDefault)} en ${idsArr.length} receta(s)?`)) return;

    // Batch update in chunks (InsForge .in() has limits)
    const CHUNK = 50;
    let ok = 0;
    for (let i = 0; i < idsArr.length; i += CHUNK) {
      const chunk = idsArr.slice(i, i + CHUNK);
      const { error } = await dbWrite(() =>
        db.from('recetas').update({ precio_prepizza: precioPrepizzaDefault, precio_salsa: precioSalsaDefault }).in('id', chunk).select()
      );
      if (error) { alert(`Error al propagar: ${error?.message ?? error}`); return; }
      ok += chunk.length;
    }

    const msg = document.getElementById('propagar-msg')!;
    msg.classList.remove('hidden');
    msg.textContent = `✓ Actualizadas ${ok} receta(s) en: ${checked.join(', ')}`;
    setTimeout(() => msg.classList.add('hidden'), 4000);
  });

  async function init() {
    const { data: config } = await db.from('config_negocio').select('id, pizzas_objetivo_mes, precio_prepizza_default, precio_salsa_default').limit(1);
    pizzasMes = config?.[0]?.pizzas_objetivo_mes ?? 800;
    configId = config?.[0]?.id ?? null;
    precioPrepizzaDefault = config?.[0]?.precio_prepizza_default ?? 485;
    precioSalsaDefault = config?.[0]?.precio_salsa_default ?? 236;
    (document.getElementById('inp-pizzas-mes') as HTMLInputElement).value = String(pizzasMes);
    (document.getElementById('inp-dias-mes') as HTMLInputElement).value = String(diasLaborablesMes);
    document.getElementById('ctx-prepizza')!.textContent = fmt(precioPrepizzaDefault);
    document.getElementById('ctx-salsa')!.textContent = fmt(precioSalsaDefault);

    const { data: ings } = await db.from('ingredientes').select('*').order('nombre', { ascending: true });
    ingredientesGlobalesCostos = ings ?? [];

    await Promise.all([renderFijos(), renderVariables(), cargarCategoriasYRecetas(), cargarGastos()]);
  }

  init().catch(showDbError);
</script>
