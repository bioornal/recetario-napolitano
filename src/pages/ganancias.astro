---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---
<Layout title="Ganancias">
  <header class="py-6 mb-4 border-b border-dark-border/50 flex items-center justify-between flex-wrap gap-3">
    <div>
      <h1 class="font-['Outfit'] text-2xl font-bold text-emerald-400">📊 Ganancias</h1>
      <p class="text-xs text-text-muted mt-1">Facturación, costos y ganancias del mes</p>
    </div>
    <div class="flex items-center gap-2">
      <input type="month" id="inp-mes"
        class="bg-dark-surface border border-dark-border rounded-xl px-3 py-1.5 text-text-main text-sm focus:ring-2 focus:ring-emerald-500/50 outline-none">
    </div>
  </header>

  <!-- Context bar -->
  <div class="glass-panel rounded-2xl p-4 mb-4 grid grid-cols-2 lg:grid-cols-6 gap-3">
    <div>
      <p class="text-[0.6rem] text-text-muted uppercase tracking-wider">Facturación</p>
      <p class="font-bold text-emerald-400 text-lg" id="ctx-facturacion">—</p>
    </div>
    <div>
      <p class="text-[0.6rem] text-text-muted uppercase tracking-wider">Ganancia Bruta</p>
      <p class="font-bold text-accent-gold" id="ctx-ganancia-bruta">—</p>
    </div>
    <div>
      <p class="text-[0.6rem] text-text-muted uppercase tracking-wider">Margen Bruto</p>
      <p class="font-bold text-emerald-400" id="ctx-margen-bruto">—</p>
    </div>
    <div>
      <p class="text-[0.6rem] text-text-muted uppercase tracking-wider">Costo Op. Mes</p>
      <p class="font-bold text-purple-400" id="ctx-costo-op">—</p>
    </div>
    <div>
      <p class="text-[0.6rem] text-text-muted uppercase tracking-wider">Gastos Extra</p>
      <p class="font-bold text-red-400" id="ctx-gastos-extra">—</p>
    </div>
    <div>
      <p class="text-[0.6rem] text-text-muted uppercase tracking-wider">Ganancia Neta</p>
      <p class="font-bold text-emerald-400 text-lg" id="ctx-ganancia">—</p>
    </div>
  </div>

  <!-- Desglose por Canal de Venta -->
  <div class="glass-panel rounded-2xl p-4 mb-4">
    <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
      <h2 class="text-xs uppercase tracking-wider text-accent-gold font-bold flex items-center gap-1.5">
        <span>🌐 Canales de Venta del Mes</span>
      </h2>
      <span class="text-[0.65rem] text-text-muted">Consolidación en tiempo real</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <!-- Impasto Card -->
      <div class="bg-dark-bg/60 border border-orange-500/30 rounded-xl p-3.5 flex flex-col justify-between">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-orange-400 font-bold text-xs flex items-center gap-1.5">
            <span class="text-sm">🍕</span> Impasto <span class="text-[0.6rem] px-1.5 py-0.5 rounded bg-orange-500/20 text-orange-300 font-semibold">Web</span>
          </span>
          <span class="text-xs font-mono text-orange-400 font-bold" id="chan-impasto-pedidos">0 pedidos</span>
        </div>
        <div class="flex items-baseline justify-between mt-1 pt-1 border-t border-orange-500/10">
          <span class="text-text-muted text-[0.65rem]"><span id="chan-impasto-units" class="text-orange-400 font-semibold">0</span> un. vendidas</span>
          <span class="font-bold text-sm text-text-main font-mono" id="chan-impasto-fact">$0</span>
        </div>
      </div>

      <!-- carroFogon Card -->
      <div class="bg-dark-bg/60 border border-emerald-500/30 rounded-xl p-3.5 flex flex-col justify-between">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-emerald-400 font-bold text-xs flex items-center gap-1.5">
            <span class="text-sm">📲</span> carroFogon <span class="text-[0.6rem] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-semibold">WhatsApp / Manual</span>
          </span>
          <span class="text-xs font-mono text-emerald-400 font-bold" id="chan-fogon-pedidos">0 pedidos</span>
        </div>
        <div class="flex items-baseline justify-between mt-1 pt-1 border-t border-emerald-500/10">
          <span class="text-text-muted text-[0.65rem]"><span id="chan-fogon-units" class="text-emerald-400 font-semibold">0</span> un. vendidas</span>
          <span class="font-bold text-sm text-text-main font-mono" id="chan-fogon-fact">$0</span>
        </div>
      </div>

      <!-- Consolidado Card -->
      <div class="bg-dark-bg/60 border border-dark-border/60 rounded-xl p-3.5 flex flex-col justify-between">
        <div class="flex items-center justify-between mb-1.5">
          <span class="text-text-main font-bold text-xs flex items-center gap-1.5">
            <span class="text-sm">📊</span> Consolidado Total
          </span>
          <span class="text-xs font-mono text-text-main font-bold" id="chan-total-pedidos">0 pedidos</span>
        </div>
        <div class="flex items-baseline justify-between mt-1 pt-1 border-t border-dark-border/30">
          <span class="text-text-muted text-[0.65rem]"><span id="chan-total-units" class="text-text-main font-semibold">0</span> un. totales</span>
          <span class="font-bold text-sm text-emerald-400 font-mono" id="chan-total-fact">$0</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Comandas y Pedidos Detallados del Mes -->
  <div class="glass-panel rounded-2xl overflow-hidden mb-4">
    <div class="flex items-center justify-between p-4 border-b border-dark-border/50 flex-wrap gap-2">
      <div class="flex items-center gap-2">
        <h2 class="text-xs uppercase tracking-wider text-accent-gold font-bold">📋 Comandas del Mes</h2>
        <span class="text-[0.65rem] text-text-muted" id="badge-pedidos-count">0 pedidos</span>
      </div>
      <div class="flex items-center gap-2 flex-wrap">
        <!-- Filtros de canal -->
        <div class="flex items-center bg-dark-bg border border-dark-border/60 rounded-lg p-0.5 text-xs">
          <button class="px-2.5 py-1 rounded font-medium transition-all bg-emerald-500/20 text-emerald-400 btn-filter-canal" data-canal="todos">Todos</button>
          <button class="px-2.5 py-1 rounded font-medium text-text-muted hover:text-text-main transition-all btn-filter-canal" data-canal="Impasto">🍕 Impasto</button>
          <button class="px-2.5 py-1 rounded font-medium text-text-muted hover:text-text-main transition-all btn-filter-canal" data-canal="carroFogon">📲 carroFogon</button>
        </div>
        <input type="text" id="inp-search-pedidos" placeholder="Buscar cliente, tel, #..." 
          class="bg-dark-bg border border-dark-border/60 rounded-lg px-2.5 py-1 text-xs text-text-main focus:ring-1 focus:ring-accent-gold outline-none w-36 sm:w-44">
      </div>
    </div>
    <div class="overflow-x-auto max-h-96">
      <table class="w-full text-xs">
        <thead class="sticky top-0 bg-dark-card border-b border-dark-border/50 z-10">
          <tr class="text-text-muted text-[0.65rem] uppercase tracking-wider">
            <th class="text-left p-3">Origen</th>
            <th class="text-left p-3"># Pedido</th>
            <th class="text-left p-3">Fecha</th>
            <th class="text-left p-3">Cliente</th>
            <th class="text-left p-3">Detalle Productos</th>
            <th class="text-right p-3">Total</th>
            <th class="text-center p-3">Estado</th>
          </tr>
        </thead>
        <tbody id="tbody-pedidos-lista">
          <tr><td colspan="7" class="p-6 text-center text-text-muted text-xs">Cargando pedidos...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Ventas del mes -->
  <div class="glass-panel rounded-2xl overflow-hidden mb-4">
    <div class="flex items-center justify-between p-4 border-b border-dark-border/50">
      <h2 class="text-xs uppercase tracking-wider text-accent-gold font-bold">Ventas por Producto</h2>
      <div class="flex items-center gap-2">
        <button id="btn-cargar-carrofogon" class="text-text-muted text-xs hover:text-text-main transition-all">Recargar datos</button>
        <button id="btn-mostrar-todos" class="text-text-muted text-xs hover:text-text-main transition-all">Mostrar todos</button>
        <button id="btn-guardar-ventas" class="bg-emerald-600/20 text-emerald-400 text-xs font-semibold px-3 py-1.5 rounded-lg hover:bg-emerald-600/40 transition-all">Guardar</button>
      </div>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-text-muted text-[0.65rem] uppercase tracking-wider border-b border-dark-border/50">
            <th class="text-left p-3">Producto</th>
            <th class="text-right p-3">Precio</th>
            <th class="text-right p-3">Costo Full</th>
            <th class="text-right p-3">Margen</th>
            <th class="text-right p-3 w-32">Unidades</th>
            <th class="text-right p-3">Facturación</th>
            <th class="text-right p-3">Ganancia</th>
          </tr>
        </thead>
        <tbody id="tbody-ventas">
          <tr><td colspan="7" class="p-6 text-center text-text-muted text-sm">Cargando ventas...</td></tr>
        </tbody>
      </table>
    </div>
    <div id="carrofogon-status" class="hidden border-t border-dark-border/50 p-3 text-xs"></div>
  </div>

  <!-- Ranking Top Productos -->
  <div id="ranking-panel" class="glass-panel rounded-2xl overflow-hidden mb-4 hidden">
    <div class="flex items-center justify-between p-4 border-b border-dark-border/50">
      <h2 class="text-xs uppercase tracking-wider text-accent-gold font-bold">Top Productos más vendidos</h2>
      <span class="text-[0.6rem] text-text-muted">Ordenados por unidades</span>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-text-muted text-[0.65rem] uppercase tracking-wider border-b border-dark-border/50">
            <th class="text-left p-3 w-8">#</th>
            <th class="text-left p-3">Producto</th>
            <th class="text-right p-3">Unidades</th>
            <th class="text-right p-3">Facturación</th>
            <th class="text-right p-3">Ganancia Bruta</th>
            <th class="text-right p-3">Margen</th>
          </tr>
        </thead>
        <tbody id="tbody-ranking"></tbody>
      </table>
    </div>
  </div>

  <!-- Gastos extra -->
  <div class="glass-panel rounded-2xl overflow-hidden mb-4">
    <div class="flex items-center justify-between p-4 border-b border-dark-border/50">
      <h2 class="text-xs uppercase tracking-wider text-red-400 font-bold">Gastos extra del mes</h2>
      <button id="btn-add-gasto" class="bg-red-600/20 text-red-400 text-xs font-semibold px-3 py-1.5 rounded-lg hover:bg-red-600/40 transition-all">+ Agregar gasto</button>
    </div>
    <table class="w-full text-sm">
      <thead>
        <tr class="text-text-muted text-[0.65rem] uppercase tracking-wider border-b border-dark-border/30">
          <th class="text-left p-3">Fecha</th>
          <th class="text-left p-3">Concepto</th>
          <th class="text-right p-3">Monto ($)</th>
          <th class="p-3"></th>
        </tr>
      </thead>
      <tbody id="tbody-gastos">
        <tr><td colspan="4" class="p-4 text-center text-text-muted text-sm">Cargando gastos...</td></tr>
      </tbody>
    </table>
    <div class="flex justify-between p-4 border-t border-dark-border/50 bg-dark-surface/50">
      <span class="text-xs text-text-muted uppercase tracking-wider">Total gastos extra</span>
      <span class="font-bold text-red-400" id="total-gastos">$0</span>
    </div>
  </div>

  <!-- Resumen final -->
  <div class="glass-panel rounded-2xl p-5 mb-4">
    <h2 class="text-xs uppercase tracking-wider text-emerald-400 font-bold mb-4">Estado de Resultados del Mes</h2>
    <div class="space-y-3">
      <div class="flex justify-between items-center py-2 border-b border-dark-border/30">
        <span class="text-sm text-text-main">+ Facturación</span>
        <span class="text-sm font-bold text-emerald-400" id="res-facturacion">$0</span>
      </div>
      <div class="flex justify-between items-center py-2 border-b border-dark-border/30">
        <span class="text-sm text-text-main">− Costo de producción (ingredientes)</span>
        <span class="text-sm font-bold text-amber-400" id="res-costo-prod">$0</span>
      </div>
      <div class="flex justify-between items-center py-3 bg-accent-gold/10 rounded-xl px-3 -mx-2">
        <span class="text-sm font-bold text-text-main uppercase">= Ganancia Bruta</span>
        <span class="text-lg font-bold text-accent-gold" id="res-ganancia-bruta">$0</span>
      </div>
      <div class="flex justify-between items-center py-2 border-b border-dark-border/30">
        <span class="text-sm text-text-main">− Costos operativos (fijos + variables)</span>
        <span class="text-sm font-bold text-purple-400" id="res-costo-op">$0</span>
      </div>
      <div class="flex justify-between items-center py-2 border-b border-dark-border/30">
        <span class="text-sm text-text-main">− Gastos extra</span>
        <span class="text-sm font-bold text-red-400" id="res-gastos">$0</span>
      </div>
      <div class="flex justify-between items-center py-3 bg-emerald-500/10 rounded-xl px-3 -mx-2">
        <span class="text-sm font-bold text-text-main uppercase">= Ganancia Neta</span>
        <span class="text-lg font-bold text-emerald-400" id="res-ganancia">$0</span>
      </div>
      <div class="flex justify-between items-center pt-1">
        <span class="text-sm text-text-main">Margen neto</span>
        <span class="text-sm font-bold text-emerald-400" id="res-margen">—</span>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { insforge } from '../lib/insforge';
  import { calcCostoOperativoPorPizza, calcCostoReceta, calcCostoRealTotal, calcPrecioEfectivo } from '../utils/pricing';
  import { fmt, showDbError, escapeHtml, dbWrite } from '../utils/fmt';

  const db = insforge.database;

  interface PedidoDetalle {
    id: string;
    numero: string;
    canal: 'Impasto' | 'carroFogon';
    fecha: string;
    cliente: string;
    telefono: string;
    direccion: string;
    items: Array<{ name: string; qty: number; price: number }>;
    itemsText: string;
    total: number;
    status: string;
  }

  // ─── Estado global ───
  let mesActual = '';
  let totalOp = 0;
  let costoOpPorPizza = 0;
  let precioPrepizzaGlobal = 485;
  let precioSalsaGlobal = 236;
  let productosVenta: any[] = [];
  let gastosData: any[] = [];
  let pedidosData: PedidoDetalle[] = [];
  let _mostrarTodos = false;
  let _filtroCanal: 'todos' | 'Impasto' | 'carroFogon' = 'todos';
  let _busquedaPedidos = '';

  const CATEGORIAS = ['Pizzas', 'Calzones', 'Empanadas', 'Hamburguesas', 'Lomos', 'Otros'] as const;

  function getMonthStr(d: Date) {
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
  }

  // ─── Inicializar mes actual ───
  mesActual = getMonthStr(new Date());
  (document.getElementById('inp-mes') as HTMLInputElement).value = mesActual;

  document.getElementById('inp-mes')!.addEventListener('change', async () => {
    mesActual = (document.getElementById('inp-mes') as HTMLInputElement).value;
    await cargarTodo();
  });

  // ─── Carga principal ───
  async function cargarTodo() {
    const [
      { data: precios },
      { data: recetas },
      { data: recetaIngs },
      { data: ingredientes },
      { data: pedidosRaw },
      { data: ventasMes },
      { data: fijos },
      { data: variables },
      { data: config },
      { data: gastosRows },
    ] = await Promise.all([
      db.from('precios_venta').select('*').order('nombre', { ascending: true }),
      db.from('recetas').select('id, nombre, precio_prepizza, precio_salsa, rend_tipo, rend_valor'),
      db.from('receta_ingredientes').select('*'),
      db.from('ingredientes').select('id, precio_kg, multiplo_rendimiento'),
      loadOrEmpty('pedidos', () => db.from('pedidos').select('id, numero_pedido, nombre_cliente, telefono_cliente, direccion, productos, total, total_con_descuento, status, estado, fecha, created_at, external_reference, proveedor_pago, email_cliente').gte('fecha', `${mesActual}-01`).lt('fecha', getNextMonth(mesActual)).order('fecha', { ascending: false })),
      loadOrEmpty('ventas_mes', () => db.from('ventas_mes').select('*').eq('mes', mesActual)),
      db.from('costos_fijos').select('monto').eq('activo', true),
      db.from('costos_variables').select('monto_referencia'),
      db.from('config_negocio').select('pizzas_objetivo_mes, precio_prepizza_default, precio_salsa_default').limit(1),
      loadOrEmpty('gastos', () => db.from('gastos').select('*').gte('fecha', `${mesActual}-01`).lt('fecha', getNextMonth(mesActual)).order('fecha', { ascending: false })),
    ]);

    // ─── Procesar y Clasificar Pedidos (Impasto vs carroFogon) ───
    pedidosData = [];
    const unidadesTotalMap = new Map<string, number>();
    const unidadesImpastoMap = new Map<string, number>();
    const unidadesFogonMap = new Map<string, number>();

    let countImpasto = 0;
    let countFogon = 0;
    let unitsImpasto = 0;
    let unitsFogon = 0;
    let factImpasto = 0;
    let factFogon = 0;

    for (const ped of (pedidosRaw ?? [])) {
      if (ped.status === 'cancelado' || ped.estado === 'cancelado') continue;

      const ref = String(ped.external_reference || '');
      const prov = String(ped.proveedor_pago || '');
      const email = String(ped.email_cliente || '');
      const prods = typeof ped.productos === 'string' ? JSON.parse(ped.productos) : (ped.productos ?? []);

      const hasImpastoRef = ref.startsWith('IM-');
      const hasEmail = email.trim().length > 0;
      const hasProveedor = prov.trim().length > 0;
      const hasNameProp = prods.length > 0 && ('name' in prods[0] || 'price' in prods[0]);

      const canal: 'Impasto' | 'carroFogon' = (hasImpastoRef || hasEmail || hasProveedor || hasNameProp) ? 'Impasto' : 'carroFogon';
      const numStr = ref || (ped.numero_pedido ? `#${ped.numero_pedido}` : '—');
      const totalPed = Number(ped.total_con_descuento ?? ped.total ?? 0);

      const itemsParsed: Array<{ name: string; qty: number; price: number }> = [];
      for (const p of prods) {
        const name = String(p.nombre || p.name || 'Producto');
        const qty = Number(p.cantidad ?? p.qty ?? 1);
        const price = Number(p.precio ?? p.price ?? 0);
        itemsParsed.push({ name, qty, price });

        const key = normalizarNombre(name);
        if (key) {
          unidadesTotalMap.set(key, (unidadesTotalMap.get(key) ?? 0) + qty);
          if (canal === 'Impasto') {
            unidadesImpastoMap.set(key, (unidadesImpastoMap.get(key) ?? 0) + qty);
          } else {
            unidadesFogonMap.set(key, (unidadesFogon.get(key) ?? 0) + qty);
          }
        }
      }

      const totalItemsQty = itemsParsed.reduce((acc, i) => acc + i.qty, 0);

      if (canal === 'Impasto') {
        countImpasto++;
        unitsImpasto += totalItemsQty;
        factImpasto += totalPed;
      } else {
        countFogon++;
        unitsFogon += totalItemsQty;
        factFogon += totalPed;
      }

      pedidosData.push({
        id: String(ped.id || ''),
        numero: numStr,
        canal,
        fecha: ped.fecha || (ped.created_at ? String(ped.created_at).slice(0, 10) : '—'),
        cliente: String(ped.nombre_cliente || 'Sin nombre'),
        telefono: String(ped.telefono_cliente || ''),
        direccion: String(ped.direccion || ''),
        items: itemsParsed,
        itemsText: itemsParsed.map(i => `${i.qty}× ${i.name}`).join(', '),
        total: totalPed,
        status: String(ped.status || ped.estado || 'normal'),
      });
    }

    // Actualizar métricas de canales en UI
    document.getElementById('chan-impasto-pedidos')!.textContent = `${countImpasto} pedidos`;
    document.getElementById('chan-impasto-units')!.textContent = String(unitsImpasto);
    document.getElementById('chan-impasto-fact')!.textContent = fmt(factImpasto);

    document.getElementById('chan-fogon-pedidos')!.textContent = `${countFogon} pedidos`;
    document.getElementById('chan-fogon-units')!.textContent = String(unitsFogon);
    document.getElementById('chan-fogon-fact')!.textContent = fmt(factFogon);

    const countTotal = countImpasto + countFogon;
    const unitsTotal = unitsImpasto + unitsFogon;
    const factTotal = factImpasto + factFogon;
    document.getElementById('chan-total-pedidos')!.textContent = `${countTotal} pedidos`;
    document.getElementById('chan-total-units')!.textContent = String(unitsTotal);
    document.getElementById('chan-total-fact')!.textContent = fmt(factTotal);
    document.getElementById('badge-pedidos-count')!.textContent = `${countTotal} pedidos`;

    // ─── Unidades manuales guardadas (ventas_mes) ───
    const unidadesManual = new Map<string, number>();
    for (const v of (ventasMes ?? [])) {
      unidadesManual.set(v.precio_venta_id, v.unidades);
    }

    // Costo operativo total (incluye gastos del mes)
    const totalFijos = (fijos ?? []).reduce((acc: number, c: any) => acc + (Number(c?.monto) || 0), 0);
    const totalVariables = (variables ?? []).reduce((acc: number, c: any) => acc + (Number(c?.monto_referencia) || 0), 0);
    const totalGastos = (gastosRows ?? []).reduce((acc: number, g: any) => acc + (Number(g?.monto) || 0), 0);
    totalOp = totalFijos + totalVariables + totalGastos;
    const pizzasMes = Number(config?.[0]?.pizzas_objetivo_mes) || 800;
    costoOpPorPizza = calcCostoOperativoPorPizza(totalOp, pizzasMes);

    precioPrepizzaGlobal = Number(config?.[0]?.precio_prepizza_default) || 485;
    precioSalsaGlobal = Number(config?.[0]?.precio_salsa_default) || 236;

    // Mapas
    const recetasMap = new Map((recetas ?? []).map((r: any) => [r.id, r]));
    const ingMap = new Map((ingredientes ?? []).map((i: any) => [i.id, i]));
    const riByReceta = new Map<string, any[]>();
    for (const ri of (recetaIngs ?? [])) {
      if (!riByReceta.has(ri.receta_id)) riByReceta.set(ri.receta_id, []);
      riByReceta.get(ri.receta_id)!.push(ri);
    }

    // ─── Armar productos con costos y asignar unidades ───
    productosVenta = [];
    for (const item of (precios ?? [])) {
      const receta = item.receta_id ? recetasMap.get(item.receta_id) : null;
      let costoUnit = 0;
      if (receta) {
        const ings = (riByReceta.get(receta.id) ?? []).map((ri: any) => {
          const ing = ingMap.get(ri.ingrediente_id);
          return {
            precio_kg: Number(ing?.precio_kg ?? 0),
            cantidad_kg: Number(ri.cantidad_kg ?? 0),
            multiplo_rendimiento: Number(ing?.multiplo_rendimiento ?? 1),
          };
        });
        const prepizza = Number(receta.precio_prepizza ?? 0);
        const salsa = Number(receta.precio_salsa ?? 0);
        const costoReceta = calcCostoReceta(ings, prepizza, salsa);

        const cat = CATEGORIAS.includes(item.subcategoria) ? item.subcategoria : 'Otros';
        if (cat === 'Empanadas' || receta.rend_tipo === 'peso') {
          const gramosPorUnidad = Number(receta.rend_valor) || 65;
          const totalNeta = ings.reduce((acc: number, ing: any) => acc + ing.cantidad_kg, 0);
          const unidades = Math.floor((totalNeta * 1000) / gramosPorUnidad);
          costoUnit = unidades > 0 ? costoReceta / unidades : costoReceta;
        } else if (receta.rend_tipo === 'directo' && Number(receta.rend_valor) > 1) {
          costoUnit = costoReceta / Number(receta.rend_valor);
        } else {
          costoUnit = costoReceta;
        }
      }
      const cat = CATEGORIAS.includes(item.subcategoria) ? item.subcategoria : 'Otros';
      const costoOpUnit = cat === 'Empanadas' ? Math.round(costoOpPorPizza / 12) : costoOpPorPizza;
      const costoReal = calcCostoRealTotal(costoUnit, costoOpUnit);
      const precioVenta = calcPrecioEfectivo(costoReal, Number(item.markup) || 1);

      const normName = normalizarNombre(item.nombre);
      const uImpasto = unidadesImpastoMap.get(normName) ?? 0;
      const uFogon = unidadesFogonMap.get(normName) ?? 0;

      // Unidades: manual (ventas_mes) > automático (pedidos) > 0
      let unidades = unidadesManual.get(item.id);
      if (unidades === undefined) {
        unidades = unidadesTotalMap.get(normName) ?? 0;
      }

      productosVenta.push({
        id: item.id,
        nombre: item.nombre,
        subcategoria: cat,
        recetaNombre: receta?.nombre ?? null,
        recetaId: item.receta_id ?? null,
        costoUnit,
        costoReal,
        precioVenta,
        markup: item.markup,
        unidades,
        unidadesImpasto: uImpasto,
        unidadesCarroFogon: uFogon,
      });
    }

    // Gastos
    gastosData = gastosRows ?? [];

    // ─── Status de sincronización ───
    const statusEl = document.getElementById('carrofogon-status')!;
    if (countTotal > 0) {
      const conManual = (ventasMes ?? []).length > 0;
      statusEl.classList.remove('hidden');
      let msg = `<span class="text-blue-400">📦 ${countTotal} pedidos sincronizados (${countImpasto} 🍕 Impasto · ${countFogon} 📲 carroFogon)</span>`;
      if (conManual) msg += `<span class="text-text-muted ml-2">| Algunas unidades tienen ajuste manual</span>`;
      statusEl.innerHTML = msg;
    } else {
      statusEl.classList.add('hidden');
    }

    renderPedidosLista();
    renderVentas();
    renderGastos();
    actualizarResumen();
  }

  function getNextMonth(ym: string): string {
    const [y, m] = ym.split('-').map(Number);
    if (m === 12) return `${y + 1}-01-01`;
    return `${y}-${String(m + 1).padStart(2, '0')}-01`;
  }

  async function loadOrEmpty(_label: string, fn: () => Promise<any>) {
    try {
      return await fn();
    } catch (err) {
      console.warn(`Tabla "${_label}" no disponible:`, err);
      return { data: [] };
    }
  }

  // ─── Render lista de pedidos / comandas ───
  function renderPedidosLista() {
    const tbody = document.getElementById('tbody-pedidos-lista')!;
    let filtrados = pedidosData;

    if (_filtroCanal !== 'todos') {
      filtrados = filtrados.filter(p => p.canal === _filtroCanal);
    }

    if (_busquedaPedidos.trim()) {
      const q = _busquedaPedidos.toLowerCase().trim();
      filtrados = filtrados.filter(p =>
        p.numero.toLowerCase().includes(q) ||
        p.cliente.toLowerCase().includes(q) ||
        p.telefono.toLowerCase().includes(q) ||
        p.itemsText.toLowerCase().includes(q)
      );
    }

    if (filtrados.length === 0) {
      tbody.innerHTML = `<tr><td colspan="7" class="p-6 text-center text-text-muted text-xs">No se encontraron pedidos con los filtros aplicados.</td></tr>`;
      return;
    }

    tbody.innerHTML = filtrados.map(p => {
      const isImpasto = p.canal === 'Impasto';
      const badgeCls = isImpasto
        ? 'bg-orange-500/20 text-orange-400 border-orange-500/30'
        : 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30';
      const badgeIcon = isImpasto ? '🍕' : '📲';
      const badgeLabel = isImpasto ? 'Impasto Web' : 'carroFogon';

      return `
        <tr class="border-b border-dark-border/20 hover:bg-dark-surface/30">
          <td class="p-3">
            <span class="inline-flex items-center gap-1 text-[0.65rem] font-semibold px-2 py-0.5 rounded-full border ${badgeCls}">
              <span>${badgeIcon}</span> ${badgeLabel}
            </span>
          </td>
          <td class="p-3 font-mono font-bold text-text-main">${escapeHtml(p.numero)}</td>
          <td class="p-3 text-text-muted whitespace-nowrap">${p.fecha}</td>
          <td class="p-3">
            <div class="font-medium text-text-main">${escapeHtml(p.cliente)}</div>
            ${p.telefono ? `<div class="text-[0.65rem] text-text-muted">${escapeHtml(p.telefono)}</div>` : ''}
          </td>
          <td class="p-3 text-text-muted max-w-xs truncate" title="${escapeHtml(p.itemsText)}">
            ${escapeHtml(p.itemsText || '—')}
          </td>
          <td class="p-3 text-right font-mono font-bold text-emerald-400 whitespace-nowrap">${fmt(p.total)}</td>
          <td class="p-3 text-center">
            <span class="text-[0.6rem] px-2 py-0.5 rounded bg-dark-surface text-text-muted border border-dark-border/40 uppercase">
              ${escapeHtml(p.status)}
            </span>
          </td>
        </tr>
      `;
    }).join('');
  }

  // Filtros de canal en comandas
  document.querySelectorAll('.btn-filter-canal').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.btn-filter-canal').forEach(b => {
        b.className = 'px-2.5 py-1 rounded font-medium text-text-muted hover:text-text-main transition-all btn-filter-canal';
      });
      const el = e.currentTarget as HTMLElement;
      el.className = 'px-2.5 py-1 rounded font-medium transition-all bg-emerald-500/20 text-emerald-400 btn-filter-canal';
      _filtroCanal = el.dataset.canal as any;
      renderPedidosLista();
    });
  });

  // Buscador de comandas
  document.getElementById('inp-search-pedidos')?.addEventListener('input', (e) => {
    _busquedaPedidos = (e.target as HTMLInputElement).value;
    renderPedidosLista();
  });

  // ─── Render ventas ───
  function renderVentas() {
    const porCategoria = new Map<string, any[]>();
    for (const cat of CATEGORIAS) porCategoria.set(cat, []);

    for (const p of productosVenta) {
      porCategoria.get(p.subcategoria)!.push(p);
    }

    let html = '';
    for (const cat of CATEGORIAS) {
      const filas = porCategoria.get(cat)!;
      const conVentas = _mostrarTodos ? filas : filas.filter(p => p.unidades > 0);
      if (conVentas.length === 0) continue;

      html += `<tr class="bg-dark-surface/60 border-t-2 border-emerald-500/30">
        <td colspan="7" class="px-3 py-2">
          <span class="text-emerald-400 text-[0.65rem] font-bold uppercase tracking-widest">${cat}</span>
          <span class="text-text-muted text-[0.6rem] ml-2">${conVentas.length} producto${conVentas.length !== 1 ? 's' : ''}</span>
        </td>
      </tr>`;

      const ordenadas = [...conVentas].sort((a, b) => b.unidades - a.unidades);

      for (const p of ordenadas) {
        const margenUnit = p.precioVenta > 0 ? Math.round((1 - p.costoReal / p.precioVenta) * 1000) / 10 : 0;
        const margenColor = margenUnit >= 40 ? 'text-emerald-400' : margenUnit >= 25 ? 'text-accent-gold' : 'text-red-400';
        const facturacion = p.precioVenta * p.unidades;
        const ganancia = (p.precioVenta - p.costoReal) * p.unidades;
        html += `<tr class="border-b border-dark-border/20 hover:bg-dark-surface/20 ${p.unidades > 0 ? '' : 'opacity-50'}">
          <td class="p-3">
            <span class="text-text-main">${escapeHtml(p.nombre)}</span>
            ${p.recetaNombre ? `<br><span class="text-text-muted text-[0.6rem]">↳ Receta: ${escapeHtml(p.recetaNombre)}</span>` : p.recetaId ? `<br><span class="text-text-muted text-[0.6rem]">↳ Receta: ${escapeHtml(p.recetaId.slice(0, 8))}...</span>` : ''}
          </td>
          <td class="p-3 text-right text-text-main font-mono">${fmt(p.precioVenta)}</td>
          <td class="p-3 text-right text-amber-400 font-mono">${fmt(p.costoReal)}</td>
          <td class="p-3 text-right ${margenColor} font-bold font-mono">${p.precioVenta > 0 ? margenUnit + '%' : '—'}</td>
          <td class="p-3 text-right">
            <input type="number" min="0" step="1" value="${p.unidades}"
              data-pid="${p.id}"
              class="w-20 bg-dark-bg border border-dark-border rounded-lg px-2 py-1 text-right text-accent-gold text-sm focus:ring-1 focus:ring-accent-amber/50 outline-none inp-unidades">
            ${(p.unidadesImpasto > 0 || p.unidadesCarroFogon > 0) ? `
              <div class="text-[0.6rem] text-text-muted mt-1 whitespace-nowrap">
                ${p.unidadesImpasto > 0 ? `<span class="text-orange-400 font-medium">🍕 ${p.unidadesImpasto}</span>` : ''}
                ${(p.unidadesImpasto > 0 && p.unidadesCarroFogon > 0) ? ' · ' : ''}
                ${p.unidadesCarroFogon > 0 ? `<span class="text-emerald-400 font-medium">📲 ${p.unidadesCarroFogon}</span>` : ''}
              </div>
            ` : ''}
          </td>
          <td class="p-3 text-right text-emerald-400 font-bold font-mono">${fmt(facturacion)}</td>
          <td class="p-3 text-right text-emerald-400 font-bold font-mono">${fmt(ganancia)}</td>
        </tr>`;
      }
    }

    document.getElementById('tbody-ventas')!.innerHTML = html || '<tr><td colspan="7" class="p-6 text-center text-text-muted text-sm">Sin ventas este mes. Se sincronizarán automáticamente de Impasto y carroFogon.</td></tr>';

    // Event listeners
    document.querySelectorAll('.inp-unidades').forEach(inp => {
      inp.addEventListener('input', () => {
        const el = inp as HTMLInputElement;
        const pid = el.dataset.pid!;
        const val = parseInt(el.value) || 0;
        const p = productosVenta.find(x => x.id === pid);
        if (p) {
          p.unidades = val;
          renderVentas();
          renderRanking();
          actualizarResumen();
        }
      });
    });

    renderRanking();
  }

  // ─── Ranking top productos ───
  function renderRanking() {
    const vendidos = productosVenta.filter(p => p.unidades > 0).sort((a, b) => b.unidades - a.unidades);
    const panel = document.getElementById('ranking-panel')!;
    const tbody = document.getElementById('tbody-ranking')!;

    if (vendidos.length === 0) {
      panel.classList.add('hidden');
      return;
    }

    panel.classList.remove('hidden');
    tbody.innerHTML = vendidos.map((p, idx) => {
      const margenUnit = p.precioVenta > 0 ? Math.round((1 - p.costoReal / p.precioVenta) * 1000) / 10 : 0;
      const margenColor = margenUnit >= 40 ? 'text-emerald-400' : margenUnit >= 25 ? 'text-accent-gold' : 'text-red-400';
      const facturacion = p.precioVenta * p.unidades;
      const ganancia = (p.precioVenta - p.costoReal) * p.unidades;
      const rankBg = idx === 0 ? 'bg-accent-gold/10' : idx === 1 ? 'bg-text-muted/5' : idx === 2 ? 'bg-amber-400/5' : '';
      const rankIcon = idx === 0 ? '🥇' : idx === 1 ? '🥈' : idx === 2 ? '🥉' : (idx + 1);
      return `<tr class="border-b border-dark-border/20 ${rankBg}">
        <td class="p-3 font-bold text-center">${rankIcon}</td>
        <td class="p-3">
          <span class="text-text-main font-medium">${escapeHtml(p.nombre)}</span>
          ${p.recetaNombre ? `<br><span class="text-text-muted text-[0.6rem]">↳ ${escapeHtml(p.recetaNombre)}</span>` : ''}
        </td>
        <td class="p-3 text-right text-accent-gold font-bold font-mono text-lg">${p.unidades}</td>
        <td class="p-3 text-right text-emerald-400 font-bold font-mono">${fmt(facturacion)}</td>
        <td class="p-3 text-right text-emerald-400 font-bold font-mono">${fmt(ganancia)}</td>
        <td class="p-3 text-right ${margenColor} font-bold font-mono">${p.precioVenta > 0 ? margenUnit + '%' : '—'}</td>
      </tr>`;
    }).join('');

    const totalUnidades = vendidos.reduce((a, p) => a + p.unidades, 0);
    const totalFacturacion = vendidos.reduce((a, p) => a + p.precioVenta * p.unidades, 0);
    const totalGanancia = vendidos.reduce((a, p) => a + (p.precioVenta - p.costoReal) * p.unidades, 0);
    const margenPromedio = totalFacturacion > 0 ? Math.round((totalGanancia / totalFacturacion) * 1000) / 10 : 0;

    tbody.innerHTML += `<tr class="border-t-2 border-emerald-500/30 bg-dark-surface/40 font-bold text-xs">
      <td class="p-3" colspan="2"><span class="text-text-muted uppercase tracking-wider">Totales (${vendidos.length} productos)</span></td>
      <td class="p-3 text-right text-accent-gold font-mono">${totalUnidades}</td>
      <td class="p-3 text-right text-emerald-400 font-mono">${fmt(totalFacturacion)}</td>
      <td class="p-3 text-right text-emerald-400 font-mono">${fmt(totalGanancia)}</td>
      <td class="p-3 text-right text-emerald-400 font-mono">${margenPromedio}%</td>
    </tr>`;
  }

  // ─── Render gastos ───
  function renderGastos() {
    const total = gastosData.reduce((a: number, g: any) => a + g.monto, 0);
    document.getElementById('total-gastos')!.textContent = fmt(total);

    document.getElementById('tbody-gastos')!.innerHTML = gastosData.length === 0
      ? '<tr><td colspan="4" class="p-4 text-center text-text-muted text-sm">Sin gastos extra este mes.</td></tr>'
      : gastosData.map((g: any) => `
        <tr class="border-b border-dark-border/30 hover:bg-dark-surface/30">
          <td class="p-3 text-text-muted text-xs">${g.fecha?.slice(0, 10) ?? '—'}</td>
          <td class="p-3 text-text-main">${escapeHtml(g.concepto)}</td>
          <td class="p-3 text-right text-red-400 font-mono">${fmt(g.monto)}</td>
          <td class="p-3">
            <button data-id="${g.id}" class="text-red-400 text-xs hover:text-red-300 btn-del-gasto">✕</button>
          </td>
        </tr>
      `).join('');

    document.querySelectorAll('.btn-del-gasto').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const id = (e.target as HTMLElement).dataset.id!;
        await dbWrite(() => db.from('gastos').delete().eq('id', id));
        await cargarTodo();
      });
    });
  }

  // ─── Resumen ───
  function actualizarResumen() {
    const facturacion = productosVenta.reduce((a, p) => a + p.precioVenta * p.unidades, 0);
    const costoProd = productosVenta.reduce((a, p) => a + p.costoUnit * p.unidades, 0);
    const gananciaBruta = facturacion - costoProd;
    const gastosExtra = gastosData.reduce((a: number, g: any) => a + g.monto, 0);
    const gananciaNeta = gananciaBruta - totalOp - gastosExtra;
    const margenBruto = facturacion > 0 ? Math.round((gananciaBruta / facturacion) * 1000) / 10 : 0;
    const margenNeto = facturacion > 0 ? Math.round((gananciaNeta / facturacion) * 1000) / 10 : 0;

    // Context bar
    document.getElementById('ctx-facturacion')!.textContent = fmt(facturacion);
    document.getElementById('ctx-ganancia-bruta')!.textContent = fmt(gananciaBruta);
    const margenBrutoEl = document.getElementById('ctx-margen-bruto')!;
    margenBrutoEl.textContent = facturacion > 0 ? `${margenBruto}%` : '—';
    margenBrutoEl.className = `font-bold ${margenBruto >= 40 ? 'text-emerald-400' : margenBruto >= 25 ? 'text-accent-gold' : 'text-red-400'}`;
    document.getElementById('ctx-costo-op')!.textContent = fmt(totalOp);
    document.getElementById('ctx-gastos-extra')!.textContent = fmt(gastosExtra);
    document.getElementById('ctx-ganancia')!.textContent = fmt(gananciaNeta);

    // Resumen
    document.getElementById('res-facturacion')!.textContent = fmt(facturacion);
    document.getElementById('res-costo-prod')!.textContent = fmt(costoProd);
    document.getElementById('res-ganancia-bruta')!.textContent = fmt(gananciaBruta);
    document.getElementById('res-costo-op')!.textContent = fmt(totalOp);
    document.getElementById('res-gastos')!.textContent = fmt(gastosExtra);
    document.getElementById('res-ganancia')!.textContent = fmt(gananciaNeta);

    const margenEl = document.getElementById('res-margen')!;
    margenEl.textContent = facturacion > 0 ? `${margenNeto}%` : '—';
    margenEl.className = `text-sm font-bold ${margenNeto >= 30 ? 'text-emerald-400' : margenNeto >= 10 ? 'text-amber-400' : 'text-red-400'}`;
  }

  // ─── Guardar ventas ───
  document.getElementById('btn-guardar-ventas')!.addEventListener('click', async () => {
    const inserts: any[] = [];
    const updates: { id: string; unidades: number }[] = [];

    const { data: existing } = await db.from('ventas_mes').select('id, precio_venta_id').eq('mes', mesActual);
    const existingMap = new Map((existing ?? []).map((v: any) => [v.precio_venta_id, v.id]));

    for (const p of productosVenta) {
      const eid = existingMap.get(p.id);
      if (eid) {
        updates.push({ id: eid, unidades: p.unidades });
      } else if (p.unidades > 0) {
        inserts.push({ precio_venta_id: p.id, mes: mesActual, unidades: p.unidades });
      }
    }

    if (inserts.length > 0) {
      await dbWrite(() => db.from('ventas_mes').insert(inserts).select());
    }
    for (const u of updates) {
      await dbWrite(() => db.from('ventas_mes').update({ unidades: u.unidades }).eq('id', u.id).select());
    }

    await cargarTodo();
    alert('Ventas guardadas ✓');
  });

  function normalizarNombre(n: string): string {
    return n.toLowerCase().trim()
      .replace(/\s+/g, ' ')
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  }

  document.getElementById('btn-cargar-carrofogon')!.addEventListener('click', async () => {
    const btn = document.getElementById('btn-cargar-carrofogon') as HTMLButtonElement;
    btn.textContent = 'Cargando...';
    await cargarTodo();
    btn.textContent = 'Recargar datos';
  });

  document.getElementById('btn-mostrar-todos')!.addEventListener('click', () => {
    _mostrarTodos = !_mostrarTodos;
    const btn = document.getElementById('btn-mostrar-todos')!;
    btn.textContent = _mostrarTodos ? 'Solo con ventas' : 'Mostrar todos';
    renderVentas();
  });

  document.getElementById('btn-add-gasto')!.addEventListener('click', async () => {
    const concepto = prompt('Concepto del gasto:');
    if (!concepto?.trim()) return;
    const monto = parseInt(prompt('Monto ($):') ?? '0');
    if (!monto || monto <= 0) return;
    const fecha = prompt('Fecha (YYYY-MM-DD, dejar vacío para hoy):') || new Date().toISOString().slice(0, 10);

    try {
      const res = await dbWrite(() => db.from('gastos').insert([{
        concepto: concepto.trim(),
        monto,
        fecha,
      }]).select());

      if (res?.error) {
        alert(`Error al guardar gasto: ${res.error?.message ?? JSON.stringify(res.error)}\n\nVerificá que la tabla "gastos" exista en la base de datos.`);
      }
    } catch (err: any) {
      alert(`Error al guardar gasto: ${err?.message ?? err}\n\nAsegurate de haber creado la tabla "gastos" en InsForge (SQL Editor).`);
    }

    await cargarTodo();
  });

  // ─── Init ───
  cargarTodo().catch(showDbError);
</script>
